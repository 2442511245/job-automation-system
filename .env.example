# 求职自动化系统 - 环境变量配置
# 复制此文件为 .env，然后根据你的需要修改

# === Flask 服务配置 ===
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# === 安全配置 ===
# Flask session 加密密钥（生产环境必须设置！随机生成方式：python -c "import secrets; print(secrets.token_hex(32))"）
FLASK_SECRET_KEY=

# 仪表盘访问密码（可选，设置后访问仪表盘需要此密码）
DASHBOARD_PASSWORD=

# === AI 模型配置（在仪表盘中配置，此处仅作参考） ===
# 阿里云百炼 API Key: 在 https://dashscope.console.aliyun.com/apiKey 获取
# 模型名称: kimi-k2.7 / qwen3.7-max / deepseek-v3 等
